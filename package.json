{
  "name": "napicu-web2",
  "version": "2.0.0",
  "author": "Numax",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build-openapi-dev": "openapi-generator-cli generate -o ./OpenAPI -i http://localhost:8080/v3/api-docs/ -g typescript-angular",
    "build-openapi-prod": "openapi-generator-cli generate -o ./OpenAPI -i https://api.napicu.eu/v3/api-docs/ -g typescript-angular",
    "build": "ng build  --build-optimizer --extract-licenses --output-hashing none",
    "buildall": "node build.js",
    "watch": "ng build --watch --configuration development",
    "pwa": "ng add @angular/pwa --project"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~18.2.8",
    "@angular/cdk": "^18.2.9",
    "@angular/common": "~18.2.8",
    "@angular/compiler": "~18.2.8",
    "@angular/core": "~18.2.8",
    "@angular/forms": "~18.2.8",
    "@angular/material": "^18.2.9",
    "@angular/platform-browser": "~18.2.8",
    "@angular/platform-browser-dynamic": "~18.2.8",
    "@angular/router": "~18.2.8",
    "@angular/service-worker": "~18.2.8",
    "@openapitools/openapi-generator-cli": "^2.14.1",
    "@techiediaries/ngx-qrcode": "^9.1.0",
    "particles.js": "^2.0.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~18.2.9",
    "@angular/cli": "~18.2.9",
    "@angular/compiler-cli": "~18.2.8",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^22.7.8",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "typescript": "5.5.4"
  }
}
